# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quitting7oh?schema=public"

# --- Discord Bot ---
# Create at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# In dev: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Required when the portal sits behind a reverse proxy (Caddy/nginx) or runs
# in production-build mode locally. Tells Auth.js to trust the request host.
AUTH_TRUST_HOST=true

# --- Docker build base ---
# Default: base-clean (no corp cert). Set to base-corp ONLY if you're on a
# corp network with a TLS-intercepting proxy AND have corp-chain.pem at the
# repo root. The base-corp build stage will inject it into the image's trust
# store so apk and npm can reach their CDNs through the proxy.
# CORP_BASE=base-corp

# --- Bootstrap admin allowlist ---
# Comma-separated Discord user IDs that bypass the per-guild admin-role check.
# Use this for initial setup; configure each guild's admin role in the portal.
BOOTSTRAP_ADMIN_USER_IDS=""

# --- Scheduler ---
# How often the bot polls for due posts, in seconds.
SCHEDULER_POLL_SECONDS="30"

# --- Reddit announcements ---
# Posts an embed to a Discord channel when a watched subreddit gets a new post.
# Configure the subreddit + channel per guild in the portal's settings page.
# Uses Reddit's public RSS feed — no API key needed.
#
# Reddit asks for a unique, descriptive User-Agent and throttles generic/missing
# ones. Format: "<platform>:<app id>:<version> (by /u/<your-reddit-username>)".
# Put YOUR Reddit username in the "by /u/..." part. Do NOT impersonate a browser.
REDDIT_USER_AGENT="discord:quitting7oh-discord-bot:1.0.0 (by /u/yourname)"
# How often the bot polls each watched subreddit, in seconds. Keep this gentle
# for unauthenticated access (default 5 min).
REDDIT_POLL_SECONDS="300"

# --- User exports ---
# Per-channel scan ceiling for user-message exports (a backstop against huge
# channels grinding the worker for hours — not a Discord limit). The export's
# index.md flags any channel where the cap was hit.
USER_EXPORT_SCAN_LIMIT="200000"

# --- Export media (attachments archived into export zips) ---
# Per-file and total-per-export caps, in MB. Files over the cap are linked to
# Discord's (expiring) CDN URLs instead and counted in the export summary.
EXPORT_MEDIA_FILE_CAP_MB="10"
EXPORT_MEDIA_TOTAL_CAP_MB="200"

# --- Scheduled-post "auto" skip mode ---
# Minimum non-bot messages in a channel since the bot last posted before an
# auto-skip post reposts. Higher = waits for more conversation before reposting.
POST_AUTO_SKIP_MIN_MESSAGES="15"

# --- Contributor leaderboard ---
# How often the background worker recomputes each guild's leaderboard, in
# hours. The page reads the cached result instantly regardless.
LEADERBOARD_REFRESH_HOURS="6"

# --- AI contributor-fit reviewer ---
# Reviews a member's message history and returns a structured "would they suit
# a contributor/peer-mentor role" verdict (see src/bot/ai-review-worker.ts).
# Without ANTHROPIC_API_KEY the feature is disabled — queued reviews fail with a
# clear message and nothing else is affected. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=""
# Final synthesis model — quality where the verdict is written.
AI_REVIEW_MODEL="claude-sonnet-5"
# Cheap high-volume model for the per-chunk "map" pass on long histories.
AI_REVIEW_MAP_MODEL="claude-haiku-4-5-20251001"
# Input-token budget that decides single-pass vs map-reduce (and bounds chunk
# size). Histories under this go in one Sonnet call; larger ones are chunked,
# each chunk pre-analyzed by the map model, then synthesized once by Sonnet.
AI_REVIEW_MAX_INPUT_TOKENS="150000"
# Hard cap on messages pulled per review (newest-first) so one prolific member
# can't grind the worker or blow the budget unbounded.
AI_REVIEW_MAX_MESSAGES="60000"

# --- Full message archive ---
# Where the archive worker writes JSONL + media. In Docker this is the shared
# archive volume (/data/archive, set in compose); the default is for bare
# `npm run bot` dev runs.
# ARCHIVE_DIR="./archive-data"
# How often the archive catches up, in seconds (default hourly).
ARCHIVE_POLL_SECONDS="3600"
# Per-file cap for archived attachments, in MB.
ARCHIVE_MEDIA_FILE_CAP_MB="25"
