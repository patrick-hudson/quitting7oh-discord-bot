# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quitting7oh?schema=public"

# --- Discord Bot ---
# Create at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# In dev: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# --- Bootstrap admin allowlist ---
# Comma-separated Discord user IDs that bypass the per-guild admin-role check.
# Use this for initial setup; configure each guild's admin role in the portal.
BOOTSTRAP_ADMIN_USER_IDS=""

# --- Scheduler ---
# How often the bot polls for due posts, in seconds.
SCHEDULER_POLL_SECONDS="30"
