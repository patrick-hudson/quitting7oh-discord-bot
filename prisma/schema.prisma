// Quitting 7OH Bot — database schema
// One Postgres DB shared by the Next.js web portal and the discord.js bot worker.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A Discord server (guild) that the bot operates in.
// Created/updated lazily when the bot joins a guild or an admin signs in.
model Guild {
  id          String   @id // Discord snowflake
  name        String
  iconUrl     String?
  timezone    String   @default("America/New_York")
  // Members with this Discord role get full portal access for this guild.
  // null = only BOOTSTRAP_ADMIN_USER_IDS can manage this guild.
  adminRoleId String?

  // Reddit new-post announcements. One watched subreddit per guild: when
  // redditEnabled is true, the bot polls /r/<redditSubreddit>/new and posts
  // each new submission to redditChannelId as an embed.
  redditEnabled   Boolean @default(false)
  redditSubreddit String? // subreddit name without the "r/" prefix
  redditChannelId String? // Discord channel snowflake to announce into
  // High-water mark: the created time of the newest submission already
  // announced. Only items strictly newer are posted. null until the first poll
  // seeds a baseline (which announces nothing, to avoid a backlog flood).
  redditLastPostAt DateTime?

  // Per-guild override for the scheduler's reminder-template roster (used when
  // a ScheduledPost has reminderContent = null). Empty array = fall back to the
  // baked-in defaults in src/lib/reminder-templates.ts. Same picker as the
  // milestone congrats roster: random, avoiding the last index used per post.
  reminderTemplates String[] @default([])

  // Member-departure announcements. When enabled, the bot posts a message to
  // leaveChannelId whenever someone leaves the server (fires for voluntary
  // leaves, kicks, and bans alike — Discord's GuildMemberRemove doesn't
  // distinguish without audit-log lookups). Templates support {user} and
  // {count}; empty roster = baked-in defaults in src/lib/leave-templates.ts.
  leaveEnabled   Boolean  @default(false)
  leaveChannelId String?
  leaveTemplates String[] @default([])
  // Anti-repeat index for the roster picker, mirroring lastReminderIndex.
  lastLeaveIndex Int?

  // Welcome DMs. When enabled, the bot DMs each member who joins (every join,
  // including rejoins). Members with DMs closed are silently skipped. Templates
  // support {user} and {server}; empty roster = baked-in defaults in
  // src/lib/welcome-templates.ts.
  welcomeDmEnabled   Boolean  @default(false)
  welcomeDmTemplates String[] @default([])
  lastWelcomeDmIndex Int?

  // Full message archive: when enabled, the archive worker incrementally
  // copies every channel's history (messages as JSONL + attachment bytes) to
  // ARCHIVE_DIR on disk. See src/bot/archive-worker.ts and BACKUPS.md.
  archiveEnabled Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts            ScheduledPost[]
  milestoneConfig  MilestoneConfig?
  milestoneTiers   MilestoneTier[]
}

// One per-guild config row tracking where the milestone-claim message lives.
model MilestoneConfig {
  id          String   @id @default(cuid())
  guildId     String   @unique
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId   String? // channel hosting the published message
  messageId   String? // id of the published message — null until first publish
  title       String   @default("Recovery Milestones")
  description String   @default("Pick the tier that reflects where you are right now. Your role updates automatically and replaces any earlier milestone role.") @db.Text

  // Optional congrats post — sent to congratsChannelId when a user claims a tier.
  congratsEnabled    Boolean  @default(false)
  congratsChannelId  String?
  // Roster of guild-level fallback templates. Used when a tier has no
  // congratsTemplates of its own. Empty = no congrats unless the tier provides one.
  congratsTemplates  String[] @default([])
  // Index of the last template picked from congratsTemplates — used by the
  // "random, avoid last used" picker.
  lastCongratsIndex  Int?

  // Roster of private (ephemeral) messages shown only to the user who clicked.
  // Same placeholder rules as congratsTemplates. Empty = use the baked-in default.
  ephemeralTemplates String[] @default([])
  lastEphemeralIndex Int?

  updatedAt DateTime @updatedAt
}

// Individual milestone (button) — many per guild. The button custom_id sent to
// Discord is "milestone:<id>", so this row's id is the source of truth.
model MilestoneTier {
  id               String  @id @default(cuid())
  guildId          String
  guild            Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  label            String // human label shown on the button ("30 days")
  emoji            String // unicode emoji ("🌱")
  roleId           String // Discord role snowflake to grant
  sortOrder         Int      @default(0)
  // Roster of per-tier congrats templates. Falls through to MilestoneConfig.congratsTemplates
  // when empty, then to no congrats post. Same placeholders as the config-level
  // template: {user} {tier} {emoji} {claimChannel}.
  congratsTemplates String[] @default([])
  // Index of the last template picked from congratsTemplates.
  lastCongratsIndex Int?

  @@index([guildId, sortOrder])
}

// One row per message the bot observes via MessageCreate. Populated by the
// bot worker so the dashboard can render activity graphs. Indexed on
// (guildId, sentAt) since every query slices by guild + time window.
//
// Storage is unbounded for now; add a periodic prune job (or rollup table)
// if it grows uncomfortably.
model MessageEvent {
  id        String   @id // Discord message snowflake
  guildId   String
  channelId String
  authorId  String
  isBot     Boolean  @default(false)
  sentAt    DateTime

  @@index([guildId, sentAt])
  // Speeds up the contributor leaderboard's group-by-author aggregate.
  @@index([guildId, authorId])
}

// A scheduled message. Either `cron` (recurring) or `runAt` (one-off) is set,
// never both. `active=false` pauses without deleting. `nextFireAt` is
// pre-computed on every write so the scheduler can use an indexed lookup.
model ScheduledPost {
  id         String   @id @default(cuid())
  guildId    String
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name       String // human label, e.g. "Sunday 7pm Recovery Meeting"
  channelIds String[] // one or more Discord channel snowflakes — the bot fans out

  // Schedule — exactly one of these is set.
  cron     String? // standard 5-field cron, e.g. "0 19 * * 0"
  runAt    DateTime? // one-off UTC timestamp
  timezone String? // overrides Guild.timezone for cron interpretation

  // Content
  useEmbed    Boolean @default(false)
  content     String  @db.Text // body text (plain) OR embed description
  embedTitle  String?
  embedColor  String? // hex like "#5865F2"
  embedUrl    String?
  embedImage  String?

  // Mentions — optional role to ping above the message.
  mentionRoleId String?

  // Minutes between when this post fires and when the meeting actually starts.
  // Used to resolve {meetingTime} placeholders in the body.
  leadMinutes Int @default(0)

  // Anti-spam for repetitive posts (e.g. a scam warning on a cron). Applies to
  // SCHEDULED fires only ("Fire now" always posts). Modes:
  //   "off"    — always post (default)
  //   "recent" — skip a channel if the previous message is still within its
  //              last `skipIfRecentWithin` messages
  //   "auto"   — skip unless enough real (non-bot) messages have been sent in
  //              the channel since the bot last posted there; the bot decides
  //              from actual activity (no number to tune)
  // lastMessageIds maps channelId → the message id of the most recent send
  // there; used for the recent-scrollback check and (via its snowflake
  // timestamp) as the "since we last posted" boundary for auto mode.
  skipMode           String @default("off")
  skipIfRecentWithin Int?
  lastMessageIds     Json?

  // Optional follow-up reminder. If set, the bot replies to each original
  // message N minutes before the meeting with a plain-text nudge. Must be
  // 1..(leadMinutes - 1) — validated at the form/API layer. null = off.
  reminderMinutes Int?
  // Per-post override for the reminder body. Same {meetingTime} placeholders
  // as `content`. null = pick from the baked-in reminder roster (see the
  // scheduler), avoiding the index in `lastReminderIndex`.
  reminderContent String? @db.Text
  // Index of the last baked-in reminder template used for this post, so the
  // picker can avoid immediate repeats. Mirrors MilestoneConfig.lastCongratsIndex.
  lastReminderIndex Int?

  // State
  active       Boolean   @default(true)
  lastFiredAt  DateTime?
  nextFireAt   DateTime? // null = no future run scheduled (e.g. fired one-off)
  // Out-of-band manual fire request set by the portal's "Fire now" button. The
  // scheduler picks these up on each tick alongside the regular due-by-time
  // query, sends the message, and clears the flag — without touching cron /
  // runAt / nextFireAt, so the normal schedule is unaffected.
  manualFireRequested Boolean @default(false)
  // Most recent send failure — set by the scheduler's catch path. lastError is
  // the truncated error message; null when the post has never failed.
  lastFailedAt DateTime?
  lastError    String?   @db.Text

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // Discord user id

  reminders PostReminder[]

  @@index([active, nextFireAt])
  @@index([guildId])
}

// One row per actual fire of a ScheduledPost that has reminderMinutes set.
// Captures the (channelId, messageId) pairs we successfully sent so the
// reminder fire can reply to each one. Rows stick around after firing as
// a thin audit trail; prune externally if the table grows.
model PostReminder {
  id      String        @id @default(cuid())
  postId  String
  post    ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  firedAt   DateTime // when the parent post actually fired
  meetingAt DateTime // the meeting itself — snapshotted so {meetingTime} renders
                    // the same value even if the parent post is edited later
  remindAt  DateTime // when this reminder should fire (meetingAt - reminderMinutes)
  sentAt    DateTime? // null = pending; set after the reply send succeeds
  // The reminder body, snapshotted at fire time (still holding {meetingTime}
  // placeholders, which are substituted with `meetingAt` at send time). Either
  // the post's reminderContent override or a pick from the baked-in roster —
  // stored so a later edit/redeploy can't change what this reminder says.
  content String @db.Text
  // Parallel arrays: channelIds[i] received messageIds[i] at the original
  // fire. Channels where the original send failed are omitted, since there's
  // no message to reply to. Order matters; do not sort or dedupe.
  channelIds String[]
  messageIds String[]
  // Most recent send failure for surfacing in the dashboard. Same shape as
  // ScheduledPost.lastFailedAt / lastError.
  lastFailedAt DateTime?
  lastError    String?   @db.Text

  // The "due now" query is `WHERE sentAt IS NULL AND remindAt <= now()`,
  // and rows are short-lived (minutes), so this composite covers it cheaply.
  @@index([sentAt, remindAt])
  @@index([postId])
}

// A background request to export one user's messages as a Markdown zip. The
// portal creates rows (status=pending); the bot worker picks them up, scans
// the selected channels via Discord's REST API filtering to the target
// author, and stores the finished zip in `output`. Postgres bytea is fine at
// this scale (a heavy user's markdown compresses to low MBs) and saves us a
// shared volume between the web and bot containers. Rows are pruned by the
// worker after `PRUNE_AFTER_DAYS` so blobs don't accumulate forever.
model UserExportJob {
  id      String @id @default(cuid())
  guildId String

  // Who to export and what slice.
  targetUserId String // Discord snowflake of the member being exported
  sinceAt      DateTime? // null = from the beginning
  untilAt      DateTime? // null = up to now
  channelIds   String[] // empty = all text channels visible to the bot

  // Archive attachment bytes into the zip (media/) so the export survives
  // Discord's ~24h signed-URL expiry.
  includeMedia Boolean @default(false)
  // pending → running → done | failed | cancelled
  status      String    @default("pending")
  // Set by the portal's Cancel button. Pending jobs flip straight to
  // cancelled before being claimed; running jobs notice between pages and
  // stop. Cleared never — cancelled rows just age out with the prune.
  cancelRequested Boolean @default(false)
  startedAt   DateTime?
  finishedAt  DateTime?
  error       String?   @db.Text
  // Summary counts for the jobs list: how many messages matched, how many
  // were scanned, per-channel breakdown lives in the zip's index.md.
  matchedCount Int @default(0)
  scannedCount Int @default(0)

  // The finished zip. null until done.
  output   Bytes?
  fileName String?

  // Discord user id of the admin who requested it — gets a best-effort DM
  // with the download link when the job finishes.
  requestedBy String
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
  @@index([guildId, createdAt])
}

// One row per action the bot takes — scheduled/manual post fires, reminders,
// Reddit announcements, welcome DMs, departure posts, milestone claims, export
// jobs. Written fire-and-forget via src/lib/audit.ts (logging must never break
// the action). Powers the portal's Audit page. Pruned after 90 days by the
// scheduler.
model BotAuditLog {
  id      String @id @default(cuid())
  guildId String
  // Dotted category.action, e.g. "post.fired", "welcome.dm_skipped",
  // "milestone.claimed". The portal filters on the prefix before the dot.
  kind    String
  // ok | warn | error — drives the status badge in the portal.
  status  String @default("ok")
  // Human-readable one-liner, e.g. `Fired "Friday KA" to 2/2 channels`.
  summary String @db.Text
  // Rich structured details: ids, channels, message ids, counts, errors.
  data    Json?

  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
  @@index([guildId, kind, createdAt])
}

// One row per moderation action observed in the guild — bans, unbans, kicks,
// timeouts (from Discord's real-time audit-log gateway event) and message
// deletions (with cached content when available). Distinct from BotAuditLog:
// these are actions BY humans, surfaced for mod accountability. Deliberately
// never pruned — accountability records keep forever.
model ModerationLog {
  id      String @id @default(cuid())
  guildId String
  // ban | unban | kick | timeout | timeout_removed | message_delete |
  // message_bulk_delete
  kind    String

  // Who did it (null when unattributable, e.g. a member deleting their own
  // message leaves no audit entry) and who it happened to.
  executorId   String?
  executorName String?
  targetId     String?
  targetName   String?

  reason    String? @db.Text
  channelId String? // message deletions
  // Deleted message text, when the message was still in the bot's cache.
  // null = content unavailable (sent before the bot's current process, or
  // swept from cache).
  content   String? @db.Text
  // Extras: attachment URLs, timeout-until, audit attribution mode, counts.
  data      Json?

  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
  @@index([guildId, kind, createdAt])
}

// A point-in-time snapshot of a guild's structure: settings, roles, channels
// (with permission overwrites), emojis, and member role-assignments/nicknames.
// Collected nightly by the scheduler and on demand from the portal. Powers
// the Snapshots page's diff view and the restore-assist feature. `data` shape
// is defined in src/lib/guild-snapshot.ts (GuildSnapshotData).
model GuildSnapshot {
  id        String   @id @default(cuid())
  guildId   String
  kind      String   @default("scheduled") // scheduled | manual
  data      Json
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

// A snapshot run, processed by the bot's snapshot worker. Exists so the portal
// can show live per-step progress + timing instead of a snapshot just
// "appearing". `steps` is an array of { name, status, ms, detail } updated as
// the worker walks each collection step. On success `snapshotId` points at the
// stored GuildSnapshot. Pruned to the recent few per guild.
model SnapshotJob {
  id          String    @id @default(cuid())
  guildId     String
  kind        String    @default("manual") // scheduled | manual
  status      String    @default("pending") // pending | running | done | failed
  steps       Json      @default("[]")
  snapshotId  String?
  error       String?   @db.Text
  requestedBy String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([guildId, createdAt])
  @@index([status, createdAt])
}

// Per-channel cursor + counters for the full message archive. The JSONL and
// media files live on disk under ARCHIVE_DIR; this row records how far the
// worker has gotten (lastMessageId = highest archived snowflake) so runs are
// incremental and crash-safe.
model ArchiveChannelState {
  id            String   @id @default(cuid())
  guildId       String
  channelId     String
  channelName   String
  // Forward cursor: highest archived snowflake. New messages after this are
  // pulled on each run to keep up.
  lastMessageId String?
  // Backfill cursor: lowest archived snowflake. The worker walks backward from
  // here until it reaches the channel's first message, then sets
  // backfillComplete so it stops paging old history.
  oldestMessageId  String?
  backfillComplete Boolean @default(false)
  archivedCount    Int     @default(0)
  mediaCount       Int     @default(0)
  mediaBytes       BigInt  @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([guildId, channelId])
  @@index([guildId])
}

// A restore-assist job: rebuild missing structure from a GuildSnapshot.
// Strictly non-destructive — the worker only CREATES roles/channels that are
// missing and ADDs roles to members; it never deletes or modifies existing
// things. Processed by src/bot/restore-worker.ts with heavy pacing (role
// creation has undocumented anti-nuke limits).
model RestoreJob {
  id         String @id @default(cuid())
  guildId    String
  snapshotId String
  // Which parts to restore: { createRoles, createChannels, reapplyMemberRoles }
  options Json
  // pending → running → done | failed
  status     String    @default("pending")
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?   @db.Text
  // Append-only progress log (array of strings) shown in the portal.
  log Json @default("[]")

  requestedBy String
  createdAt   DateTime @default(now())

  @@index([guildId, createdAt])
  @@index([status, createdAt])
}

// --- Auth.js (NextAuth v5) tables ---
// Standard Prisma adapter schema; lets users sign in via Discord OAuth.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Stamped by an Auth.js `events.signIn` callback on each successful sign-in.
  lastSignInAt  DateTime?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
